# Copy to .env (never commit .env).
DOCKER_VOL_DATA=./docker-data/client-data
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_DB_EXTERNAL_PORT=3306
# DOCKER_DB_ROOT_PASSWORD=change-me

# ac-manager dashboard
MANAGER_BIND=127.0.0.1
MANAGER_PORT=28090
MANAGER_USER=admin
MANAGER_PASSWORD=change-me
# GM level 3 account the dashboard uses for SOAP commands (create it in game/console)
SOAP_USER=ACMANAGER
SOAP_PASS=change-me
